# =========================================================================
# Auto-Send Multi-Bot Environment Variables
# =========================================================================

# Credenciais para o Local Telegram Bot API Server (permite envio de vídeos de até 2GB).
# Obtenha em https://my.telegram.org (API development tools).
# Se deixadas em branco, o backend fará fallback transparente para https://api.telegram.org (limite de 50MB).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# URL base da API do Telegram (opcional).
# No Docker Compose, é configurada automaticamente com fallback inteligente.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Nomes extras pelos quais a API aceita ser chamada, separados por vírgula (ex.: o domínio de um proxy reverso).
# O loopback (127.0.0.1, localhost, [::1]) é sempre aceito; qualquer outro cabeçalho Host recebe 400.
ALLOWED_HOSTS=
